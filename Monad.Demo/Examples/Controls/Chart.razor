<Chart Items="Items" ItemValue="item => item.Value" Type="ChartType.Area" />
<Chart Items="Items" ItemValue="item => item.Value" Type="ChartType.Bar" />
<Chart Items="Items" ItemValue="item => item.Value" Type="ChartType.Dot" />
<Chart Items="Items" ItemValue="item => item.Value" Type="ChartType.Line" />
<Chart Items="Items" ItemValue="item => item.Value" Type="ChartType.Pie" />
<Chart Items="Items" ItemValue="item => item.Value" Type="ChartType.Waterfall" />

<button @onclick="RandomizeValues">Randomize values</button>

@code {
    private List<ChartItem> Items { get; } = new(ChartItem.CreateDemoRange(count: 6));

    private void RandomizeValues()
        => Items.ForEach(item => item.RandomizeValue());
}
