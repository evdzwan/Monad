<Gauge Minimum="0" Maximum="100" Value="@Value" Type="GaugeType.Circle" />
<Gauge Minimum="0" Maximum="100" Value="@Value" Type="GaugeType.Ring" />
<Gauge Minimum="0" Maximum="100" Value="@Value" Type="GaugeType.Tachometer" />

<button @onclick="RandomizeValue">Randomize value</button>

@code {
    private int Value { get; set; } = GetRandomValue();

    private static int GetRandomValue()
        => Random.Shared.Next(10, 90);

    private void RandomizeValue()
        => Value = GetRandomValue();
}
