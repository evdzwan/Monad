@page "/controls/collapser"

<PageTitle>Collapser</PageTitle>
<h2 class="page-title">Collapser</h2>
<p class="page-subtitle">
    Use <code>Collapser</code> to conditionally show or hide your content. The hidden part stays rendered in the DOM tree.
</p>

<div class="page-examples">
    <ExampleViewer Title="Example" Resource="Controls.Collapser">
        <section>
            <button @onclick="() => IsExpanded = !IsExpanded">Toggle</button>
            <Collapser Active="IsExpanded">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </Collapser>
        </section>
    </ExampleViewer>
</div>

<div class="page-members">
    <MembersViewer Type="typeof(Collapser)" />
</div>

@code {
    private bool IsExpanded { get; set; }
}
