@page "/controls/chart"

<PageTitle>Chart</PageTitle>
<h2 class="page-title">Chart</h2>
<p class="page-subtitle">
    Show charts of various types with the <code>Chart</code> component.
</p>

<div class="page-examples">
    <Grid>
        <Columns>
            <GridColumn Width="Size.Fraction(1)" />
            <GridColumn Width="Size.Fraction(1)" Scope="Breakpoint.Medium" />
            <GridColumn Width="Size.Fraction(1)" Scope="Breakpoint.Large" />
        </Columns>

        <Content>
            @foreach (var chartType in Enum.GetValues<ChartType>())
            {
                <ExampleViewer Title="@chartType.ToString()">
                    <Chart Items="Items" ItemValue="item => item.Value" Type="chartType" />
                </ExampleViewer>
            }
        </Content>
    </Grid>

    <ExampleViewer Title="Example" Resource="Controls.Chart">
        <button @onclick="RandomizeValues">Randomize values</button>
    </ExampleViewer>
</div>

<div class="page-members">
    <MembersViewer Type="typeof(Chart<>)" />
</div>

@code {
    private List<ChartItem> Items { get; } = new(ChartItem.CreateDemoRange(count: 6));

    private void RandomizeValues()
        => Items.ForEach(item => item.RandomizeValue());
}
