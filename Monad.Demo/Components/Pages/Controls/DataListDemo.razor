@page "/controls/data-list"

<PageTitle>DataList</PageTitle>
<h2 class="page-title">DataList</h2>
<p class="page-subtitle">
    Use <code>DataList</code> to provide an input or <code>Editor</code> with suggestions.
</p>

<div class="page-examples">
    <ExampleViewer Title="Example" Resource="Controls.DataList">
        <DataList Items="Enumerable.Range(1, 10)" ProvideItemText="@(i => $"Example item {i}")">
            <input list="@context.DataListId" placeholder="Focus to see data list" />
            <Editor Value="string.Empty" Placeholder="Same goes for this one" />
        </DataList>
    </ExampleViewer>
</div>

<div class="page-members">
    <MembersViewer Type="typeof(DataList<>)" />
    <MembersViewer Type="typeof(IDataListProvider)" />
    <MembersViewer Type="typeof(IDataListProvider<>)" />
</div>
