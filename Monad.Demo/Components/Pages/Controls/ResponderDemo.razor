@page "/controls/responder"

<PageTitle>Responder</PageTitle>
<h2 class="page-title">Responder</h2>
<p class="page-subtitle">
    Show content dependent on screen size with the <code>Responder</code> component.
</p>

<div class="page-examples">
    <ExampleViewer Title="Example" Resource="Controls.Responder">
        <Responder>
            <Default>Default</Default>
            <Small>Small</Small>
            <Medium>Medium</Medium>
            <Large>Large</Large>
        </Responder>

        <Responder>
            <Default>Smaller than Medium</Default>
            <Medium>Medium or Large</Medium>
        </Responder>
    </ExampleViewer>
</div>

<div class="page-members">
    <MembersViewer Type="typeof(Responder)" />
</div>
