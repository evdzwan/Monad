@page "/controls/themer"

<PageTitle>Themer</PageTitle>
<h2 class="page-title">Themer</h2>
<p class="page-subtitle">
    Wrap your components in <code>Themer</code> to be able to specify a CSS theme.
    This demo app has <code>Themer</code> wrapped around the main <code>Router</code> component.
</p>

<div class="page-examples">
    <ExampleViewer Title="Example">
        <Grid>
            <Columns>
                <GridColumn Width="Size.Fraction(1)" />
                <GridColumn Width="Size.Fraction(1)" />
            </Columns>

            <Content>
                <Themer Theme="light">
                    <div class="themer-content">Light theme</div>
                </Themer>

                <Themer Theme="dark">
                    <div class="themer-content">Dark theme</div>
                </Themer>
            </Content>
        </Grid>
    </ExampleViewer>

    <ExampleViewer Title="Example" Resource="Controls.Themer">
        <button @onclick="ToggleTheme">Toggle theme</button>
    </ExampleViewer>
</div>

<div class="page-members">
    <MembersViewer Type="typeof(Themer)" />
    <MembersViewer Type="typeof(IThemeController)" />
</div>

@code {
    [CascadingParameter]
    private IThemeController? ThemeController { get; set; }

    private void ToggleTheme()
    {
        if (ThemeController is { } themeController)
        {
            themeController.SetTheme(themeController.Theme == "dark" ? "light" : "dark");
        }
    }
}
