@page "/controls/span"

<PageTitle>Span</PageTitle>
<h2 class="page-title">Span</h2>
<p class="page-subtitle">
    Use the <code>Span</code> component to span an element across multiple rows or columns in a <code>Grid</code> layout.
</p>

<div class="page-examples">
    <ExampleViewer Title="Example" Resource="Controls.Span">
        <Grid>
            <Columns>
                <GridColumn />
                <GridColumn />
                <GridColumn />
                <GridColumn />
            </Columns>

            <Content>
                <div>Item 1</div>
                <Span Horizontal="2">Item 2</Span>
                <div>Item 3</div>
                <Span Horizontal="2" Vertical="2">Item 4</Span>
                <div>Item 5</div>
                <Span Vertical="2">Item 6</Span>
                <div>Item 7</div>
            </Content>
        </Grid>
    </ExampleViewer>
</div>

<div class="page-members">
    <MembersViewer Type="typeof(Span)" />
</div>
