@page "/controls/fill"

<PageTitle>Fill</PageTitle>
<h2 class="page-title">Fill</h2>
<p class="page-subtitle">
    Use <code>Fill</code> to stretch its contents out so it fills the remaining space.
</p>

<div class="page-examples">
    <ExampleViewer Title="Example" Resource="Controls.Fill">
        <Stack Horizontal>
            <div>Item 1</div>
            <div>Item 2</div>
            <Fill>
                <div>Item 3 (surrounded by <code>Fill</code>)</div>
            </Fill>
            <div>Item 4</div>
            <div>Item 5</div>
        </Stack>
    </ExampleViewer>
</div>

<div class="page-members">
    <MembersViewer Type="typeof(Fill)" />
</div>
