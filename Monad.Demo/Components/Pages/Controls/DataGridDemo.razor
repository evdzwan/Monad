@page "/controls/data-grid"

<PageTitle>DataGrid</PageTitle>
<h2 class="page-title">DataGrid</h2>
<p class="page-subtitle">
    Use <code>DataGrid</code> to display (large) sets of data in a tabular form.
    Surround the grid with a <code>Scroller</code> component to enable scrolling.
    The <code>DataGrid</code> doesn't virtualize by default, so be careful when displaying large amounts of data, or enable virtualizing with the <code>Virtualize</code> parameter.
</p>

<div class="page-examples">
    <Grid>
        <Columns>
            <GridColumn Width="Size.Fraction(1)" />
            <GridColumn Width="Size.Fraction(1)" Scope="Breakpoint.Medium" />
        </Columns>

        <Content>
            <ExampleViewer Title="Basic">
                <Scroller Vertical>
                    <DataGrid Items="Items.Take(50)">
                        <DataGridExpressionColumn Value="item => item.Id" />
                        <DataGridExpressionColumn Value="item => item.Name" Width="Size.Percentage(100)" />
                        <DataGridTemplateColumn Context="item" Title="Value">
                            <span class="symbol">@((char)item.Value)</span>
                        </DataGridTemplateColumn>
                    </DataGrid>
                </Scroller>
            </ExampleViewer>

            <ExampleViewer Title="UI virtualization">
                <Scroller Vertical>
                    <DataGrid Items="Items" OverscanCount="25" Virtualize>
                        <DataGridExpressionColumn Value="item => item.Id" Width="Size.Pixels(47.05)">
                            <Placeholder>
                                <span>...</span>
                            </Placeholder>
                        </DataGridExpressionColumn>
                        <DataGridExpressionColumn Value="item => item.Name" Width="Size.Percentage(100)" />
                        <DataGridTemplateColumn Context="item" Title="Value">
                            <span class="symbol">@((char)item.Value)</span>
                        </DataGridTemplateColumn>
                    </DataGrid>
                </Scroller>
            </ExampleViewer>

            <ExampleViewer Title="Data virtualization">
                <Scroller Vertical>
                    <DataGrid ItemsProvider="ItemsProvider" OverscanCount="25" Virtualize>
                        <DataGridExpressionColumn Value="item => item.Id" Width="Size.Pixels(47.05)">
                            <Placeholder>
                                <span>...</span>
                            </Placeholder>
                        </DataGridExpressionColumn>
                        <DataGridExpressionColumn Value="item => item.Name" Width="Size.Percentage(100)" />
                        <DataGridTemplateColumn Context="item" Title="Value">
                            <span class="symbol">@((char)item.Value)</span>
                        </DataGridTemplateColumn>
                    </DataGrid>
                </Scroller>
            </ExampleViewer>

            <ExampleViewer Title="Selection">
                <Scroller Vertical>
                    <Selector Selection="SelectedItems" Multiple>
                        <DataGrid Items="Items.Take(50)">
                            <DataGridExpressionColumn Value="item => item.Id" />
                            <DataGridExpressionColumn Value="item => item.Name" Width="Size.Percentage(100)" />
                            <DataGridTemplateColumn Context="item" Title="Value">
                                <span class="symbol">@((char)item.Value)</span>
                            </DataGridTemplateColumn>
                        </DataGrid>
                    </Selector>
                </Scroller>
            </ExampleViewer>
        </Content>
    </Grid>

    <ExampleViewer Title="Example" Resource="Controls.DataGrid">
        <button @onclick="RandomizeValues">Randomize values</button>
    </ExampleViewer>
</div>

<div class="page-members">
    <MembersViewer Type="typeof(DataGrid<>)" />
    <MembersViewer Type="typeof(DataGridColumn<>)" />
    <MembersViewer Type="typeof(DataGridExpressionColumn<,>)" />
    <MembersViewer Type="typeof(DataGridTemplateColumn<>)" />
</div>

@code {
    private List<DataGridItem> Items { get; } = new(DataGridItem.CreateDemoRange(count: 1_000));

    private DataGridItemsProvider<DataGridItem> ItemsProvider => async request =>
    {
        await Task.Delay(500);
        var items = Items.Skip(request.StartIndex).Take(request.Count).ToArray();
        return new(items, reachedEnd: items.Length < request.Count);
    };

    private List<DataGridItem> SelectedItems { get; } = [];

    protected override void OnInitialized()
        => SelectedItems.Add(Items[1]);

    private void RandomizeValues()
        => Items.ForEach(item => item.RandomizeValue());
}
