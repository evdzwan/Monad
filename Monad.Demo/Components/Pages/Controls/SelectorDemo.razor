@page "/controls/selector"

<PageTitle>Selector</PageTitle>
<h2 class="page-title">Selector</h2>
<p class="page-subtitle">
    Enable selection by surround your code with the <code>Selector</code> component.
</p>

<div class="page-examples">
    <ExampleViewer Title="Example" Resource="Controls.Selector">
        <Selector Selection="SelectedItems" Multiple>
            <Stack Vertical>
                @foreach (var i in Enumerable.Range(1, 5))
                {
                    <button class="@(context.IsActive(i) ? "active" : null)" @onclick="() => context.Toggle(i)">Item @i</button>
                }
            </Stack>
        </Selector>
    </ExampleViewer>
</div>

<div class="page-members">
    <MembersViewer Type="typeof(Selector<>)" />
    <MembersViewer Type="typeof(ISelection<>)" />
</div>

@code {
    private List<int> SelectedItems { get; } = [2];
}
