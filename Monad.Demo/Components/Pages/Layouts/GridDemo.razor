@page "/layouts/grid"

<PageTitle>Grid</PageTitle>
<h2 class="page-title">Grid</h2>
<p class="page-subtitle">
    Surround your markup with <code>Grid</code> to create a responsive grid layout, with aligned columns and rows.
    Note that cells are placed automatically, and that, if needed, columns and rows are added as well.
    Use the <code>Scope</code> parameter on a <code>GridColumn</code> to make it dependent on screen size.
</p>

<div class="page-examples">
    <ExampleViewer Title="Example" Resource="Layouts.Grid">
        <Grid>
            <Columns>
                <GridColumn Width="Size.Fraction(1)" />
                <GridColumn Scope="Breakpoint.Small" />
                <GridColumn Scope="Breakpoint.Medium" />
                <GridColumn Scope="Breakpoint.Large" Width="Size.Percentage(20)" />
            </Columns>

            <Content>
                @foreach (var i in Enumerable.Range(1, 12))
                {
                    <div>Item @i</div>
                }
            </Content>
        </Grid>
    </ExampleViewer>
</div>

<div class="page-members">
    <MembersViewer Type="typeof(Grid)" />
    <MembersViewer Type="typeof(GridColumn)" />
    <MembersViewer Type="typeof(GridRow)" />
</div>
