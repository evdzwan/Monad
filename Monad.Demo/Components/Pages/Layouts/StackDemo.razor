@page "/layouts/stack"

<PageTitle>Stack</PageTitle>
<h2 class="page-title">Stack</h2>
<p class="page-subtitle">
    Use <code>Stack</code> to stack children horizontally or vertically.
</p>

<div class="page-examples">
    <ExampleViewer Title="Example" Resource="Layouts.Stack">
        <Stack Horizontal>
            <div>Item 1</div>
            <div>Item 2</div>
            <div>Item 3</div>
            <div>Item 4</div>
            <div>Item 5</div>
        </Stack>
        
        <Stack Vertical>
            <div>Item 1</div>
            <div>Item 2</div>
            <div>Item 3</div>
            <div>Item 4</div>
            <div>Item 5</div>
        </Stack>
    </ExampleViewer>
</div>

<div class="page-members">
    <MembersViewer Type="typeof(Stack)" />
</div>
