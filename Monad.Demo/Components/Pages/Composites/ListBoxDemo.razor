@page "/composites/list-box"

<PageTitle>ListBox</PageTitle>
<h2 class="page-title">ListBox</h2>
<p class="page-subtitle">
    You can create an list box with selectable items by combining the <code>Selector</code>, <code>Scroller</code> and <code>Stack</code> components.
</p>

<div class="page-examples">
    <ExampleViewer Title="Example" Resource="Composites.ListBox">
        <Selector Selection="SelectedItems">
            <Scroller Vertical>
                <Stack Vertical>
                    @foreach (var item in Items)
                    {
                        <div class="item @GetItemClass(context.IsActive(item))" @onclick="() => context.Toggle(item)" @key="item">
                            Example item @item
                        </div>
                    }
                </Stack>
            </Scroller>
        </Selector>
    </ExampleViewer>
</div>

@code {
    private int[] Items { get; } = Enumerable.Range(1, 50).ToArray();

    private List<int> SelectedItems { get; } = [2];

    private static string? GetItemClass(bool active)
        => active ? "active" : null;
}
