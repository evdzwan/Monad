<div class="example">
    <h4>@Title</h4>

    @if (ChildContent is { } content)
    {
        <div class="example-content">
            @content
        </div>
    }

    @foreach (var resourceItem in ResourceItems)
    {
        <div class="example-resource" @key="resourceItem.Key">
            <pre><code>@resourceItem.Value</code></pre>
        </div>
    }
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Resource { get; set; }

    private ResourceItem[] ResourceItems { get; set; } = [];

    [Parameter, EditorRequired]
    public required string Title { get; set; }

    private static async Task<ResourceItem> CreateResourceItem(string resourceKey)
    {
        await using var stream = typeof(ExampleViewer).Assembly.GetManifestResourceStream(resourceKey);
        if (stream is not { CanRead: true })
        {
            return new(resourceKey, $"Failed to load resource stream '{resourceKey}'");
        }

        using var reader = new StreamReader(stream);
        return new(resourceKey, (await reader.ReadToEndAsync()).TrimEnd());
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Resource is { Length: > 0 } resource)
        {
            var streamName = $"Monad.Examples.{resource}";
            var resourceKeys = await Task.Run(() => GetType().Assembly.GetManifestResourceNames()
                                                                      .Where(key => key.StartsWith(streamName, StringComparison.OrdinalIgnoreCase))
                                                                      .OrderBy(key => key switch
                                                                      {
                                                                          { } when key.EndsWith(".cs") => 1,
                                                                          { } when key.EndsWith(".razor") => 2,
                                                                          { } when key.EndsWith(".css") => 3,
                                                                          _ => 4,
                                                                      }));

            ResourceItems = await Task.WhenAll(resourceKeys.Select(CreateResourceItem));
        }
    }

    private sealed record class ResourceItem(string Key, string Value);
}
