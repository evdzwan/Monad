<div class="stack @StackClass">
    @ChildContent
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Horizontal { get; set; }

    private string StackClass => ClassList.Create("horizontal", Horizontal)
                                          .Add("vertical", Vertical);

    [Parameter]
    public bool Vertical { get; set; }
}
