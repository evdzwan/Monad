<div class="stack @StackClass">
    @ChildContent
</div>

@code {
    [Parameter, Description("Content to be rendered.")]
    public RenderFragment? ChildContent { get; set; }

    [Parameter, Description("Controls wether the stack is horizontally oriented.")]
    public bool Horizontal { get; set; }

    private string StackClass => ClassList.Create("horizontal", Horizontal)
                                          .Add("vertical", Vertical);

    [Parameter, Description("Controls wether the stack is vertically oriented.")]
    public bool Vertical { get; set; }
}
