<div class="gauge @GaugeClass">
    <div class="gauge-backdrop" />
    <div class="gauge-entity" style="@GaugeEntityStyle" />
</div>

@code {
    private string GaugeClass => ClassList.Create(Casing.ToKebabCase(Type.ToString()));

    private string GaugeEntityStyle => StyleList.Create("--value", Value)
                                                .Add("--value-min", Minimum)
                                                .Add("--value-max", Maximum);

    [Parameter, EditorRequired]
    public required double Maximum { get; set; }

    [Parameter, EditorRequired]
    public required double Minimum { get; set; }

    [Parameter]
    public required GaugeType Type { get; set; }

    [Parameter, EditorRequired]
    public required double Value { get; set; }
}
