<CascadingValue Value="_themeController" IsFixed>
    <div class="themer" monad-theme="@Theme">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly ThemeController _themeController = new();

    [Parameter, Description("Content to be rendered.")]
    public RenderFragment? ChildContent { get; set; }

    [Parameter, Description("Active theme.")]
    public string? Theme { get; set; }

    [Parameter, Description("Invoked when <code>Theme</code> changes.")]
    public EventCallback<string?> ThemeChanged { get; set; }

    protected override void OnInitialized()
        => _themeController.ThemeChanged += OnThemeChanged;

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        var prevTheme = Theme;
        await base.SetParametersAsync(parameters);
        if (Theme != prevTheme)
        {
            _themeController.Theme = Theme;
        }
    }

    private async void OnThemeChanged(string? theme)
    {
        try
        {
            await SetTheme(theme);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private Task SetTheme(string? theme)
    {
        Theme = theme;
        return ThemeChanged.InvokeAsync(theme);
    }
}
