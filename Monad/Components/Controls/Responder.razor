<div class="responder">
    <div class="responder-content">
        @Default
    </div>
    <div class="responder-content-sm">
        @(Small ?? Default)
    </div>
    <div class="responder-content-md">
        @(Medium ?? Small ?? Default)
    </div>
    <div class="responder-content-lg">
        @(Large ?? Medium ?? Small ?? Default)
    </div>
</div>

@code {
    [Parameter, Description("Shown when no other overrides apply.")]
    public RenderFragment? Default { get; set; }

    [Parameter, Description("Shown only on large screens.")]
    public RenderFragment? Large { get; set; }

    [Parameter, Description("Shown on medium screens, or on large if <code>Large</code> is not set.")]
    public RenderFragment? Medium { get; set; }

    [Parameter, Description("Shown on small screens, or on medium/large if <code>Medium</code> or <code>Large</code> are not set.")]
    public RenderFragment? Small { get; set; }
}
