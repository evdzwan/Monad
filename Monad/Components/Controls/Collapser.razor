<div class="collapser @CollapserClass">
    <div class="collapser-container">
        <div class="collapser-content">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter, Description("Controls when <code>ChildContent</code> is visible.")]
    public bool Active { get; set; }

    [Parameter, Description("Content to be rendered.")]
    public RenderFragment? ChildContent { get; set; }

    private string CollapserClass => ClassList.Create("active", Active);
}
