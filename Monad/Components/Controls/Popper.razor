<div class="popper @PopperClass" tabindex="-1" @onfocusout="Close">
    <div class="popper-trigger">
        @Trigger
    </div>
    <div class="popper-content">
        @Content
    </div>
</div>

@code {
    [Parameter, Description("Controls when <code>Content</code> is visible.")]
    public bool Active { get; set; }

    [Parameter, Description("Invoked when <code>Active</code> changes.")]
    public EventCallback<bool> ActiveChanged { get; set; }

    [Parameter, Description("Controls wether <code>Active</code> changes when focus is lost.")]
    public bool CollapseOnFocusLost { get; set; }

    [Parameter, EditorRequired, Description("Content area that's conditionally visible.")]
    public required RenderFragment Content { get; set; }

    private string PopperClass => ClassList.Create("active", Active);

    [Parameter, EditorRequired, Description("Trigger area that's always visible.")]
    public required RenderFragment Trigger { get; set; }

    private Task Close()
        => CollapseOnFocusLost ? SetActive(active: false) : Task.CompletedTask;

    private Task SetActive(bool active)
    {
        Active = active;
        return ActiveChanged.InvokeAsync(active);
    }
}
